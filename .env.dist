APP_NAME="REST API Slim"
APP_ENV=local
APP_BASE_URL="http://localhost:8000"

AUTH_ACCESS_TOKEN_TTL="+30 minutes"
AUTH_REFRESH_TOKEN_TTL="+30 days"

CORS_ALLOWED_ORIGINS="http://localhost:8000"
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE"
CORS_ALLOWED_HEADERS="Authorization, Content-Type"
CORS_MAX_AGE=600
CORS_EXPOSED_HEADERS="RateLimit-Limit, RateLimit-Remaining, RateLimit-Reset, Retry-After, X-Pagination-Total-Count, X-Pagination-Total-Pages, X-Pagination-Current-Page, X-Pagination-Per-Page"

EMAIL_VERIFICATION_TTL="+24 hours"

MAILER_DSN="smtp://localhost:1025"
MAILER_FROM_ADDRESS="no-reply@example.com"
MAILER_FROM_NAME="REST API Slim"

DB_DRIVER=Pdo_Mysql
DB_DATABASE=rest_api_slim
DB_HOSTNAME=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

PASSWORD_RESET_TTL="+1 hour"

RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW=60

REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TIMEOUT=1
REDIS_READ_WRITE_TIMEOUT=1
REDIS_DATABASE=0
REDIS_PREFIX=rest-api-slim:
REDIS_USERNAME=
REDIS_PASSWORD=